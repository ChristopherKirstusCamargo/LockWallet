<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext off everywhere; trust only system CAs (user-added CAs are not trusted, also in debug). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
