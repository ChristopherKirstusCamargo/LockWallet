<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ splash (platform API; minSdk 31, no extra dependency): background = launch_bg (follows system
      day/night), the Lock Wallet padlock without an icon plate. MainActivity holds it until the first frame is ready
      (minimum 450 ms so it never "flashes") and then fades/scales it out smoothly.
    -->
    <style name="Theme.LockWallet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
